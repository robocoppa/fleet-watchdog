# Copy to .env and fill in. .env is gitignored — never commit the token.
#
# WATCHDOG_TOKEN: token of a NEW Telegram bot made just for alerts (the
#   "watcher" bot). Create it via @BotFather → /newbot. Do NOT reuse a
#   monitored bot's token — a down bot can't deliver its own alert.
# WATCHDOG_CHAT_ID: your chat id. Easiest way to find it: DM your new watcher
#   bot anything, then open
#   https://api.telegram.org/bot<WATCHDOG_TOKEN>/getUpdates and read
#   result[].message.chat.id.

WATCHDOG_TOKEN=
WATCHDOG_CHAT_ID=

# Optional tuning:
WATCHDOG_DEFAULT_STALE=600   # seconds before an unregistered bot is "stale"
WATCHDOG_TICK=60             # watchdog evaluation interval, seconds

<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd job for one bot's heartbeat. launchd is the Mac equivalent
  of a systemd timer: StartInterval fires the job on a fixed cadence.

  Unlike systemd's EnvironmentFile, launchd doesn't read an env file, so the
  job runs a per-bot WRAPPER script that exports the vars then execs
  heartbeat.sh. cron-wrapper.sh already does exactly that — reuse it.

  Install (one .plist per bot — rename for each). No /usr/local/bin copy: the
  wrapper execs heartbeat.sh straight from the checkout, so the self-updater's
  git pull is the whole deploy. Clone the repo in a dir you own (e.g.
  ~/fleet-watchdog), then make a per-bot wrapper (holds a token) in your HOME:
    mkdir -p ~/.fleet-heartbeat
    cp heartbeat/cron-wrapper.sh ~/.fleet-heartbeat/brigitte.sh
    chmod 700 ~/.fleet-heartbeat/brigitte.sh
    # edit that wrapper: set BOT_ID, BOT_TOKEN, PROBE_CHAT, WATCHDOG_URL,
    # HOST_LABEL; its last line execs $HOME/fleet-watchdog/heartbeat/heartbeat.sh
    # (set FLEET_CHECKOUT in the wrapper if cloned elsewhere).

    # rename Label + ProgramArguments + log paths below for this bot, then:
    cp heartbeat/com.fleet-watchdog.heartbeat.plist.example \
       ~/Library/LaunchAgents/com.fleet-watchdog.brigitte.plist
    launchctl load ~/Library/LaunchAgents/com.fleet-watchdog.brigitte.plist

  A LaunchAgent (~/Library/LaunchAgents, runs as the logged-in user) is
  right here: the wrapper holds the bot's own token and the bot itself runs
  as that user. Use a LaunchDaemon (/Library/LaunchDaemons, runs as root)
  only if the bot is a system service.

  NOTE: launchd does NOT expand ~ — ProgramArguments must be an ABSOLUTE
  path (e.g. /Users/brigitte/.fleet-heartbeat/brigitte.sh).

  Manage:
    launchctl list | grep fleet-watchdog        # is it loaded?
    launchctl start com.fleet-watchdog.brigitte  # fire once now
    launchctl unload ~/Library/LaunchAgents/com.fleet-watchdog.brigitte.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fleet-watchdog.brigitte</string>

    <!-- The per-bot wrapper (exports env, execs heartbeat.sh).
         ABSOLUTE path — launchd does not expand ~. Replace 'brigitte' with
         your user + bot. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/brigitte/.fleet-heartbeat/brigitte.sh</string>
    </array>

    <!-- Fire every 300s (5 min) — matches the systemd timer's cadence.
         launchd also fires once at load, so the first beat is immediate.
         Keep in sync with the hub's stale_after (>= 2x this + margin). -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- Don't keep it resident; it's a one-shot that exits each run. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Logs, for debugging the sender. -->
    <key>StandardOutPath</key>
    <string>/tmp/fleet-heartbeat-brigitte.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fleet-heartbeat-brigitte.err</string>
</dict>
</plist>

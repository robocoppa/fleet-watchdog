# Per-bot heartbeat config. One file per bot.
#
# systemd:  /etc/fleet-heartbeat/<bot-id>.env  (referenced by %i in the unit)
# cron:     source this file in your cron wrapper, or inline the vars.
#
# Keep this file readable only by root — it holds the bot's Telegram token.
#   sudo chmod 600 /etc/fleet-heartbeat/<bot-id>.env

# Must match the id in the watchdog's registry.yaml.
BOT_ID=brigitte

# The MONITORED bot's own token (the bot being watched, not the watcher bot).
BOT_TOKEN=123456:ABC-the-monitored-bots-token

# The SHARED probe channel — a private, muted channel that exists only for
# health probes. The bot posts a heartbeat here (not deleted) to prove it can
# send on Telegram, without cluttering any real chat. Same value for every bot;
# they're told apart by the message content. (Make the channel, add each
# monitored bot as an admin so it can post, grab its -100… chat id.)
PROBE_CHAT=-1001234567890

# The watchdog receiver on Unraid.
WATCHDOG_URL=http://192.168.1.11:9099/beat

# Optional: a label for which machine this is (defaults to `hostname`).
HOST_LABEL=mac-mini

# Optional: model backend health url to include backend_ok in the heartbeat.
# Ollama:  http://192.168.1.11:11434/api/version
# Audrey:  http://192.168.1.11:8000/healthz
#BACKEND_URL=http://192.168.1.11:11434/api/version
